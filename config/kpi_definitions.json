{
  "Revenue": {
    "formula": "sum(revenue)",
    "unit": "INR",
    "primary_source": "sales.csv",
    "driver_dimensions": [
      "region",
      "product"
    ]
  },
  "Profit": {
    "formula": "sum(revenue - product_cost - marketing_spend)",
    "unit": "INR",
    "primary_source": "sales.csv",
    "driver_dimensions": [
      "region",
      "product",
      "marketing_spend"
    ]
  },
  "Orders": {
    "formula": "sum(orders)",
    "unit": "orders",
    "primary_source": "sales.csv",
    "driver_dimensions": [
      "region",
      "product",
      "stockouts"
    ]
  },
  "Conversion Rate": {
    "formula": "sum(orders) / sum(sessions)",
    "unit": "%",
    "primary_source": "sales.csv",
    "driver_dimensions": [
      "region",
      "product"
    ]
  },
  "Return Rate": {
    "formula": "sum(returned_units) / sum(units_sold)",
    "unit": "%",
    "primary_source": "customer_metrics.csv",
    "driver_dimensions": [
      "region",
      "product",
      "customer_feedback"
    ]
  }
}