{
  "Revenue": {
    "formula": "sum(revenue)",
    "unit": "INR",
    "primary_source": "sales.csv",
    "driver_dimensions": [
      "region",
      "product"
    ]
  },

  "Profit": {
    "formula": "sum(revenue - product_cost - marketing_spend)",
    "unit": "INR",
    "primary_source": "sales.csv",
    "driver_dimensions": [
      "region",
      "product"
    ]
  },

  "Orders": {
    "formula": "sum(orders)",
    "unit": "count",
    "primary_source": "sales.csv",
    "driver_dimensions": [
      "region",
      "product"
    ]
  },

  "Conversion Rate": {
    "formula": "sum(orders) / sum(sessions) * 100",
    "unit": "percent",
    "primary_source": "sales.csv",
    "driver_dimensions": [
      "region",
      "product"
    ]
  },

  "Return Rate": {
    "formula": "sum(returned_units) / sum(units_sold) * 100",
    "unit": "percent",
    "primary_source": "customer_metrics.csv",
    "driver_dimensions": [
      "region",
      "product"
    ]
  }
}