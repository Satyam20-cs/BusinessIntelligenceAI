{
  "Revenue": {
    "definition": "Total realized sales revenue after discounts and returns.",
    "formula": "sum(revenue)",
    "unit": "INR",
    "frequency": "daily",
    "warning_threshold_pct": 5,
    "critical_threshold_pct": 10,
    "drivers": [
      "region",
      "product",
      "orders",
      "inventory",
      "customer_complaints"
    ],
    "sources": [
      "sales",
      "inventory",
      "customer_metrics"
    ],
    "access": [
      "Business Head",
      "Business Analyst"
    ]
  },
  "Profit": {
    "definition": "Revenue minus product cost and marketing spend.",
    "formula": "sum(revenue - product_cost - marketing_spend)",
    "unit": "INR",
    "frequency": "daily",
    "warning_threshold_pct": 5,
    "critical_threshold_pct": 10,
    "drivers": [
      "revenue",
      "marketing_spend",
      "product_cost",
      "region"
    ],
    "sources": [
      "sales",
      "customer_metrics"
    ],
    "access": [
      "Business Head",
      "Business Analyst"
    ]
  },
  "Orders": {
    "definition": "Number of completed customer orders.",
    "formula": "sum(orders)",
    "unit": "orders",
    "frequency": "daily",
    "warning_threshold_pct": 5,
    "critical_threshold_pct": 10,
    "drivers": [
      "region",
      "product",
      "conversion_rate",
      "stockouts"
    ],
    "sources": [
      "sales",
      "inventory"
    ],
    "access": [
      "Business Head",
      "Business Analyst"
    ]
  },
  "Conversion Rate": {
    "definition": "Completed orders divided by site sessions.",
    "formula": "sum(orders) / sum(sessions)",
    "unit": "%",
    "frequency": "daily",
    "warning_threshold_pct": 5,
    "critical_threshold_pct": 10,
    "drivers": [
      "region",
      "product",
      "customer_complaints"
    ],
    "sources": [
      "sales",
      "customer_metrics"
    ],
    "access": [
      "Business Head",
      "Business Analyst"
    ]
  },
  "Return Rate": {
    "definition": "Returned units divided by sold units.",
    "formula": "sum(returned_units) / sum(units_sold)",
    "unit": "%",
    "frequency": "daily",
    "warning_threshold_pct": 5,
    "critical_threshold_pct": 10,
    "drivers": [
      "product",
      "region",
      "customer_complaints"
    ],
    "sources": [
      "sales",
      "customer_metrics"
    ],
    "access": [
      "Business Head",
      "Business Analyst"
    ]
  }
}